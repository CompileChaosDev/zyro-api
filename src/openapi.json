{
  "openapi": "1.0.0",
  "info": {
    "title": "malix",
    "author": "zyro",
    "version": "v1.0.0",
    "description": "Simple and easy to use API."
  },
  "servers": [
    { "url": "/" }
  ],
  "tags": [
    { "name": "AI" },
    { "name": "Anime" },
    { "name": "Downloader" },
    { "name": "Image" },
    { "name": "News" }
  ],
  "paths": {
    "/ai/copilot": {
      "get": {
        "summary": "Copilot Chat",
        "description": "Kirim pertanyaan ke Copilot Microsoft dan dapatkan jawaban beserta referensi/citations",
        "tags": ["AI"],
        "parameters": [
          {
            "name": "message",
            "in": "query",
            "required": true,
            "description": "Pesan atau pertanyaan yang ingin dikirim ke Copilot",
            "schema": { "type": "string" }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Model Copilot yang digunakan (default: 'default', opsional: 'think-deeper', 'gpt-5')",
            "schema": { "type": "string", "enum": ["default", "think-deeper", "gpt-5"], "default": "default" }
          }
        ],
        "responses": {
          "200": { "description": "Berhasil mendapatkan jawaban dari Copilot" },
          "400": { "description": "Request invalid, message kosong" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/ai/venice": {
      "get": {
        "summary": "Venice AI Chat",
        "description": "Mengirim pertanyaan ke model Venice AI dan mendapatkan jawaban final.",
        "tags": ["AI"],
        "parameters": [
          {
            "name": "message",
            "in": "query",
            "required": true,
            "description": "Teks atau pertanyaan yang ingin dikirim ke Venice AI",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Berhasil mendapatkan jawaban dari Venice AI" },
          "400": { "description": "Request invalid, message kosong" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/anime/waifu": {
      "get": {
        "summary": "Waifu",
        "description": "Mengambil gambar waifu secara acak dari API waifu.pics.",
        "tags": ["Anime"],
        "parameters": [],
        "responses": {
          "200": { "description": "Berhasil mengambil gambar waifu" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/download/mediafire": {
      "get": {
        "summary": "MediaFire Downloader",
        "description": "Mengambil link unduhan langsung beserta detail informasi file dari MediaFire.",
        "tags": ["Downloader"],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "description": "URL halaman file MediaFire yang ingin diunduh",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://www.mediafire.com/file/example/file.zip/file"
            }
          }
        ],
        "responses": {
          "200": { "description": "Berhasil mendapatkan detail dan link unduhan MediaFire" },
          "400": { "description": "URL tidak diisi atau tidak valid" },
          "500": { "description": "Gagal memproses permintaan" }
        }
      }
    },
    "/download/capcut": {
      "get": {
        "summary": "CapCut Downloader",
        "description": "Ambil data dan video template dari CapCut berdasarkan URL template",
        "tags": ["Downloader"],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "description": "URL template CapCut yang ingin diambil datanya",
            "required": true,
            "schema": { "type": "string", "format": "uri" }
          }
        ],
        "responses": {
          "200": { "description": "Respon berhasil" },
          "400": { "description": "URL tidak disertakan" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/download/pinterest": {
      "get": {
        "summary": "Pinterest",
        "description": "Mengambil data dan link media (video/image) dari URL Pinterest / pin.it.",
        "tags": ["Downloader"],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "description": "URL Pinterest / pin.it yang ingin di-download",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://pin.it/lOPdveAO7"
            }
          }
        ],
        "responses": {
          "200": { "description": "Berhasil mengambil data Pinterest" },
          "400": { "description": "URL tidak valid" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/download/tiktok": {
      "get": {
        "summary": "TikTok",
        "description": "Download video TikTok",
        "tags": ["Downloader"],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "description": "URL video TikTok yang ingin diunduh",
            "required": true,
            "schema": { "type": "string", "format": "uri" }
          }
        ],
        "responses": {
          "200": { "description": "Respon berhasil" },
          "400": { "description": "URL tidak disertakan" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/image/bluearchive": {
      "get": {
        "summary": "Blue Archive",
        "description": "Blue Archive Random Images",
        "tags": ["Image"],
        "responses": {
          "200": { "description": "Respon berhasil" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/image/loli": {
      "get": {
        "summary": "loli",
        "description": "Loli Random Images",
        "tags": ["Image"],
        "responses": {
          "200": { "description": "Respon berhasil" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/image/mpls": {
      "get": {
        "summary": "Mpls Generator",
        "description": "Membuat Twibbon dari foto user dan frame MPLS",
        "tags": ["Image"],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "URL foto user",
            "schema": { "type": "string", "format": "uri" }
          }
        ],
        "responses": {
          "200": { "description": "Respon berhasil, mengembalikan image PNG" },
          "400": { "description": "Missing ?url= parameter" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/image/papayang": {
      "get": {
        "summary": "papayang",
        "description": "papayang Random Images",
        "tags": ["Image"],
        "responses": {
          "200": { "description": "Respon berhasil" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/image/wallpaper": {
      "get": {
        "summary": "Wallpaper",
        "description": "Random images from WallpaperFlare based on search query",
        "tags": ["Image"],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search query (e.g., Naruto, Anime, Landscape)",
            "required": false,
            "schema": { "type": "string", "example": "Naruto" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of images to return (default 5, max 10)",
            "required": false,
            "schema": { "type": "integer", "example": 5 }
          }
        ],
        "responses": {
          "200": { "description": "Respon berhasil" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/news/detik": {
      "get": {
        "summary": "Detik News",
        "description": "Scraping berita terpopuler dari Detik.com",
        "tags": ["News"],
        "responses": {
          "200": { "description": "Respon berhasil" },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/news/kontan": {
      "get": {
        "summary": "Kontan News",
        "description": "Scraping berita terbaru dari Kontan.co.id",
        "tags": ["News"],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "berita": {
                        "type": "string",
                        "example": "Rupiah menguat terhadap dolar AS pada perdagangan pagi ini"
                      },
                      "berita_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://www.kontan.co.id/news/rupiah-menguat"
                      },
                      "berita_thumb": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true,
                        "example": "https://img.kontan.co.id/thumb.jpg"
                      },
                      "berita_jenis": {
                        "type": "string",
                        "example": "Makro Ekonomi"
                      },
                      "berita_diupload": {
                        "type": "string",
                        "example": "2 jam lalu"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": { 
            "description": "Gagal memproses request" 
          }
        }
      }
    }
  }
}
